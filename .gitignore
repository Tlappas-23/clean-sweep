# ---- Python ----
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Data ----
# Raw bulk downloads (IMDb TSVs are ~1.4 GB) are never committed; run
# `python -m pipeline.download` to fetch them. The small processed seed
# tables in data/seed/ ARE committed so the app runs out of the box.
data/raw/
data/processed/
# The box office project's per-response API caches (TMDB, OMDb, Wikidata):
# tens of thousands of tiny JSON files that every rebuild rewrites. They are
# raw data in the same sense as data/processed/ and are kept out for the same
# reason. The derived artifacts beside them ARE committed, so the model, the
# tests, the notebook and the API all work on a fresh clone; the caches are
# regenerated by `python -m backend.boxoffice.pipeline.rebuild --network`.
backend/boxoffice/data/cache/
*.tsv.gz
*.tsv

# ---- Runtime ----
*.db
*.sqlite3
*.log

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/

# Trained model artifacts ARE committed (a few MB) so the analytics page and
# the game work on a fresh clone; the joblib files are regenerated by
# `python -m ml.train_ranker` / `python -m ml.cluster`.
!data/models/
.neon
