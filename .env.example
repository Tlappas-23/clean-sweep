# Copy to `.env` and fill in. Every value here is OPTIONAL: the game runs on
# the committed IMDb + Oscar seed data with no configuration at all.

# --- Pipeline enrichment keys (optional) ------------------------------------
# Without these `python -m pipeline.enrich` has nothing to fetch, and the
# box-office metric stays null. The scorer renormalises its weights over the
# metrics that are present, so the game plays identically either way.

# https://www.themoviedb.org/settings/api  (free)  -> revenue, budget, posters
TMDB_API_KEY=

# https://www.omdbapi.com/apikey.aspx  (free tier: 1000 requests/day)
# -> Rotten Tomatoes critic score, Metascore, box office
OMDB_API_KEY=

# --- Backend settings (optional; defaults shown) ----------------------------
# All are prefixed CLEAN_SWEEP_ so they never collide with the keys above.
# Paths default to absolute locations derived from the repo root, so you only
# need these if you move the data or point at a different database.

# CLEAN_SWEEP_SEED_DIR=./data/seed
# CLEAN_SWEEP_MODELS_DIR=./data/models
# CLEAN_SWEEP_DB_URL=sqlite:///./clean_sweep.db

# Browser origins allowed by CORS, comma-separated (Vite dev server default).
# CLEAN_SWEEP_CORS_ORIGINS=http://localhost:5173
