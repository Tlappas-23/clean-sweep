# Copy to `.env` and fill in. Both keys are OPTIONAL: the game runs on the
# committed IMDb + Oscar seed data without them. Adding them lets the
# enrichment pipeline pull box office, Rotten Tomatoes and Metacritic scores.

# https://www.themoviedb.org/settings/api  (free)  -> revenue, budget, posters
TMDB_API_KEY=

# https://www.omdbapi.com/apikey.aspx      (free tier: 1000 req/day)
# -> Rotten Tomatoes critic score, Metascore, box office
OMDB_API_KEY=

# Backend settings (defaults shown)
CLEAN_SWEEP_DB_URL=sqlite:///./clean_sweep.db
CLEAN_SWEEP_SEED_DIR=../data/seed
CLEAN_SWEEP_CORS_ORIGINS=http://localhost:5173
